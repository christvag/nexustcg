# Application Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Application URLs
NEXT_PUBLIC_APP_URL=https://tcg.nexusgrading.com
NEXTAUTH_URL=https://tcg.nexusgrading.com

# WordPress Main Domain (for CORS)
WORDPRESS_DOMAIN=https://nexusgrading.com

# Stripe API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# JWT Secret Key (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database URL (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/tcg_grading

# API URL for card data (if using external API)
CARD_API_URL=https://api.example.com/cards