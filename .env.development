# Development Environment Variables (for local development outside Docker)
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Stripe API Keys (replace with your actual keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=keys-here
STRIPE_SECRET_KEY=keys-here
# Database URL (for local PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tcg_grading
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tcg_grading
DB_USER=postgres
DB_PASSWORD=password

# Application URL
NEXTAUTH_URL=http://localhost:3000

